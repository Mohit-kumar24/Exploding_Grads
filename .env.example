# KingdomForge Environment Configuration
# Copy this file to .env and configure your model credentials

# Model configuration (OpenAI-compatible chat completions)
MODEL=gpt-4o-mini
API_KEY=your_api_key_here
BASE_URL=https://api.openai.com/v1

# Task and evaluation settings
# Tasks available: task_1 through task_13 (task_3 is demo)
TASK_ID=task_3
SEED=42

# Mode: full (baselines + model evaluation), all (all tasks), baselines (baselines only)
MODE=baselines

# Instructions append file (appended to system prompt)
APPEND_FILE=inputs/append.txt
